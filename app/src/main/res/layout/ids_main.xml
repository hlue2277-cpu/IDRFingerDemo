<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnOne"
            android:layout_width="85dp"
            android:layout_height="wrap_content"
            android:text="单次读卡"
            android:textSize="12dp" />

        <Button
            android:id="@+id/btnMul"
            android:layout_width="85dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:padding="1dp"
            android:text="连续读卡"
            android:textSize="12dp" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="85dp"
            android:layout_height="wrap_content"
            android:padding="1dp"
            android:text="停止读卡"
            android:textSize="12dp" />

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="0dp"
        android:orientation="horizontal"
        android:visibility="visible">

        <TextView
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"

            android:gravity="center"
            android:text="串口名："
            android:textSize="12dp" />

        <EditText
            android:id="@+id/etSerialName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@+id/textView2"
            android:layout_alignParentStart="true"
            android:ems="10"
            android:inputType="textPersonName"
            android:text="/dev/ttyS1" />
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="250dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="centerInside"
            android:src="@drawable/idzm"></ImageView>

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_marginLeft="75dp"
            android:layout_marginTop="42dp"
            android:textSize="15sp"
            android:textColor="#000000"
            ></TextView>

        <TextView
            android:id="@+id/tvSex"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_marginLeft="75dp"
            android:layout_marginTop="70dp"
            android:textSize="15sp"
            android:textColor="#000000"
            ></TextView>

        <TextView
            android:id="@+id/tvNation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_marginLeft="156dp"
            android:layout_marginTop="70dp"
            android:textSize="15sp"
            android:textColor="#000000"
            ></TextView>

        <TextView
            android:id="@+id/tvBirthY"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_marginLeft="73dp"
            android:layout_marginTop="98dp"
            android:textSize="15sp"
            android:textColor="#000000"
            ></TextView>
        <TextView
            android:id="@+id/tvBirthM"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_marginLeft="127dp"
            android:layout_marginTop="98dp"
            android:textSize="15sp"
            android:textColor="#000000"
            ></TextView>

        <TextView
            android:id="@+id/tvBirthD"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_marginLeft="161dp"
            android:layout_marginTop="98dp"
            android:textSize="15sp"
            android:textColor="#000000"
            ></TextView>
        <TextView
            android:id="@+id/tvAddress"
            android:layout_width="168dp"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_marginLeft="75dp"
            android:layout_marginTop="128dp"
            android:textSize="15sp"
            android:textColor="#000000"
            ></TextView>

        <TextView
            android:id="@+id/tvID"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_marginLeft="124dp"
            android:layout_marginTop="197dp"
            android:textSize="15sp"
            android:textColor="#000000"
            ></TextView>

        <ImageView
            android:id="@+id/ivID"
            android:layout_width="112.8dp"
            android:layout_height="138.9dp"
            android:layout_marginTop="22dp"
            android:layout_marginRight="10dp"
            android:layout_marginLeft="242dp"/>

    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="240dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="centerInside"
            android:layout_marginTop="0dp"
            android:layout_marginLeft="0dp"
            android:src="@drawable/idfm"></ImageView>


        <TextView
            android:id="@+id/tvDepart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_marginLeft="155dp"
            android:layout_marginTop="165dp"
            android:textSize="15sp"
            android:textColor="#000000"
            ></TextView>

        <TextView
            android:id="@+id/tvValidityTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_marginLeft="155dp"
            android:layout_marginTop="195dp"
            android:textSize="15sp"
            android:textColor="#000000"
            ></TextView>

    </FrameLayout>

    <TextView
        android:id="@+id/tvVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="V2.1"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:textSize="15sp"
        android:visibility="visible"
        android:layout_marginTop="30dp"
        android:textColor="#000000"
        ></TextView>


</LinearLayout>