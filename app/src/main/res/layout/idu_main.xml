<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center_horizontal"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnOne"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:padding="1dp"
            android:text="单次读卡"
            android:textSize="12dp" />

        <Button
            android:id="@+id/btnMul"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:padding="1dp"
            android:text="连续读卡"
            android:textSize="12dp" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:padding="1dp"
            android:text="停止读卡"
            android:textSize="12dp" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center_horizontal">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="centerInside"
            android:src="@drawable/idzm"></ImageView>

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_marginLeft="78dp"
            android:layout_marginTop="81dp"
            android:textSize="15sp"
            android:textColor="#000000"
            ></TextView>

        <TextView
            android:id="@+id/tvSex"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_marginLeft="78dp"
            android:layout_marginTop="111dp"
            android:textSize="15sp"
            android:textColor="#000000"
            ></TextView>

        <TextView
            android:id="@+id/tvNation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_marginLeft="166dp"
            android:layout_marginTop="111dp"
            android:textSize="15sp"
            android:textColor="#000000"
            ></TextView>

        <TextView
            android:id="@+id/tvBirthY"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_marginLeft="78dp"
            android:layout_marginTop="141dp"
            android:textSize="15sp"
            android:textColor="#000000"
            ></TextView>
        <TextView
            android:id="@+id/tvBirthM"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_marginLeft="140dp"
            android:layout_marginTop="141dp"
            android:textSize="15sp"
            android:textColor="#000000"
            ></TextView>

        <TextView
            android:id="@+id/tvBirthD"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_marginLeft="176dp"
            android:layout_marginTop="141dp"
            android:textSize="15sp"
            android:textColor="#000000"
            ></TextView>
        <TextView
            android:id="@+id/tvAddress"
            android:layout_width="168dp"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_marginLeft="78dp"
            android:layout_marginTop="172dp"
            android:textSize="15sp"
            android:textColor="#000000"
            ></TextView>

        <TextView
            android:id="@+id/tvID"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_marginLeft="125dp"
            android:layout_marginTop="250dp"
            android:textSize="15sp"
            android:textColor="#000000"
            ></TextView>

        <ImageView
            android:id="@+id/ivID"
            android:layout_width="125.3dp"
            android:layout_height="154.35dp"
            android:layout_marginTop="65dp"
            android:layout_marginRight="10dp"
            android:layout_marginLeft="250dp"/>

    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/idfm"></ImageView>


        <TextView
            android:id="@+id/tvDepart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_marginLeft="170dp"
            android:layout_marginTop="218dp"
            android:textSize="15sp"
            android:textColor="#000000"
            ></TextView>

        <TextView
            android:id="@+id/tvValidityTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_marginLeft="170dp"
            android:layout_marginTop="250dp"
            android:textSize="15sp"
            android:textColor="#000000"
            ></TextView>

    </FrameLayout>

    <TextView
        android:id="@+id/tvVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="V2.1"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="3dp"
        android:textSize="15sp"
        android:textColor="#000000"
        ></TextView>


</LinearLayout>